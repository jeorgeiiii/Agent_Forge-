# Copy to .env and fill in. Never commit the real .env.
DATABASE_URL=sqlite:///./agentforge.db
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_TASK_QUEUE=agentforge
CORS_ORIGINS=http://localhost:3000
REDIS_URL=redis://localhost:6379/0
NEXT_PUBLIC_API_URL=http://localhost:8000

# Copilot / LLM provider (OpenAI-compatible). Groq is used when COPILOT_* is empty.
COPILOT_API_URL=
COPILOT_API_KEY=
COPILOT_MODEL=gpt-4o-mini
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Auth & security
AUTH_REQUIRED=false
TRUSTED_PROXIES=
# Shared secret between API and worker (any long random string)
INTERNAL_API_TOKEN=
# Worker -> API address (use 127.0.0.1, not localhost, on Windows)
AGENTFORGE_API_URL=http://127.0.0.1:8000
PUBLIC_BASE_URL=http://localhost:8000

# Credential vault: 32 random bytes, urlsafe base64
# python -c "import os,base64;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
CREDENTIALS_MASTER_KEY=
