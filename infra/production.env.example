# Copy to production.env (never commit it) and fill in. Used by docker-compose.prod.yml.
# Generate secrets:  python -c "import secrets;print(secrets.token_urlsafe(48))"
# Vault key:         python -c "import os,base64;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"

PUBLIC_APP_URL=https://app.example.com        # the web app address people open
PUBLIC_BASE_URL=https://app.example.com       # public address of the API (webhook links); same host is fine with /api
POSTGRES_PASSWORD=
INTERNAL_API_TOKEN=
CREDENTIALS_MASTER_KEY=
FILE_SIGNING_KEY=
TRUSTED_PROXIES=                               # IP of your reverse proxy / load balancer

# AI (one of these)
GROQ_API_KEY=
GROQ_MODEL=
COPILOT_API_URL=
COPILOT_API_KEY=
COPILOT_MODEL=

# Email (invites)
MAIL_BACKEND=smtp
MAIL_FROM=AgentForge <no-reply@example.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# Files: local (this server's disk) or s3
STORAGE_BACKEND=local
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
